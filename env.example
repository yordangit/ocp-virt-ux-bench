# Copy to ./env.sh and edit. Sourced by bench.sh / dispatch.sh.
# Load order: built-in defaults → env.sh (only if unset) → CLI / already-exported env (wins).
#
# External benches are SOFT: empty value = skip (no score impact).
# If set and the check fails, the run still continues but the score is penalized.

# --- Guest VM (the Fedora probe you create) ---
GUEST_UX_IMAGE=fedora
GUEST_UX_VM_PROFILE=default          # default | small
# Explicit size overrides profile when set:
# GUEST_UX_VM_CORES=2
# GUEST_UX_VM_MEMORY=4Gi
# GUEST_UX_VM_DISK=30Gi
GUEST_UX_SC=ocs-storagecluster-ceph-rbd-virtualization
# Seconds between guest-VM creates when GUEST_UX_WORKER=all
GUEST_UX_VM_STAGGER_SEC=10

# --- Cluster workers (OpenShift nodes that host VMs) ---
# busiest | any | <node-name> | all
GUEST_UX_WORKER=busiest
# Skip a worker if oc adm top shows CPU/mem at or above these %
GUEST_UX_WORKER_MAX_CPU=80
GUEST_UX_WORKER_MAX_MEM=85

# --- External network from inside the guest (soft) ---
# Small public git clone = network + disk stand-in
GUEST_UX_GIT_URL=https://github.com/yordangit/ocp-virt-ux-bench.git
GUEST_UX_PING_TARGET=8.8.8.8
GUEST_UX_DNS_NAME=google.com
GUEST_UX_DOWNLOAD_URL=http://speedtest.tele2.net/10MB.zip
